<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher hosts these RemoteViews. The application window theme draws no background here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#FFF8F5"
    tools:ignore="Overdraw">
    <TextView android:id="@+id/shortcuts_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/shortcuts_app_name" android:maxLines="1" android:ellipsize="end" android:textColor="#202124" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/shortcuts_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/shortcuts_choose_application" android:maxLines="2" android:ellipsize="end" android:textColor="#202124" android:textSize="14sp" />
    <LinearLayout style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/shortcuts_start" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/shortcuts_start" android:enabled="false" />
        <Button android:id="@+id/shortcuts_stop" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/shortcuts_stop" android:enabled="false" />
        <Button android:id="@+id/shortcuts_open" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/shortcuts_open" android:enabled="false" />
    </LinearLayout>
    <Button android:id="@+id/shortcuts_change" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/shortcuts_choose_application" />
</LinearLayout>
